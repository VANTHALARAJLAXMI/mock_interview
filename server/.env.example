# Copy to server/.env for local development.
# On Render, set the same names in the service Environment tab (do not commit real keys).

OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_MS=60000

# true forces demo mode even when a key is set
MOCK_AI=

PORT=5000
CLIENT_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
# Set to 1 on Render (render.yaml already does this)
TRUST_PROXY=0

# Optional. Leave empty to store history in the browser only.
MONGODB_URI=
